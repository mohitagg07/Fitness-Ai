{
  "expo": {
    "name": "VYRN",
    "slug": "vyrn-mobile",
    "version": "1.0.0",
    "scheme": "vyrn",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vyrn.app"
    },
    "android": {
      "package": "com.vyrn.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs photo access for form check uploads."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#16EC06"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "mohitagg07",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d5798a4-5950-4f07-926e-afcd78ae936a"
      }
    }
  }
}