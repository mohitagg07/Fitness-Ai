{
  "expo": {
    "name": "VYRN",
    "slug": "vyrn-mobile",
    "version": "1.0.0",
    "scheme": "vyrn",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F3EA",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F5F3EA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vyrn.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F3EA"
      },
      "package": "com.vyrn.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs photo access for form check uploads."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#176B4A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "mohitagg07",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d5798a4-5950-4f07-926e-afcd78ae936a"
      }
    }
  }
}
