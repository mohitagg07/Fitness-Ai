{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://neurofit-ai-backend.onrender.com/api",
        "EXPO_PUBLIC_VYRN_QA_BUILD": "false"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://neurofit-ai-backend.onrender.com/api",
        "EXPO_PUBLIC_VYRN_QA_BUILD": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
