# VYRN mobile API URL.
# Local web/iOS simulator: http://localhost:8000/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Android Emulator (uncomment when using the Android emulator):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Physical phone on the same Wi-Fi: replace with your laptop's LAN IPv4.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api

# Installed builds must use a publicly reachable HTTPS backend URL.
