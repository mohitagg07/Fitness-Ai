# VYRN backend API.
# This default works in Expo Go, a physical Android/iOS phone, and EAS builds.
EXPO_PUBLIC_API_URL=https://neurofit-ai-backend.onrender.com/api

# To test against a backend running on your laptop instead, replace the value:
# Android Emulator: http://10.0.2.2:8000/api
# iOS Simulator / Web on the same laptop: http://localhost:8000/api
# Physical phone on the same Wi-Fi: http://YOUR_LAPTOP_LAN_IP:8000/api
#
# For a physical phone, use your laptop's LAN IPv4 address and allow port 8000
# through the firewall. Never use localhost from a physical phone.
