# Copy this file to .env in the frontend/ folder and fill in your values.
# After editing, restart Expo with: npx expo start --clear
#
# CRITICAL: This must end with /api — the app's axios client sets
# baseURL to this value and then calls paths like /auth/login,
# /mission/today, etc. If you omit /api the paths become
# https://your-app.onrender.com/auth/login which returns 404 because
# the backend mounts everything under /api/auth/login.
#
# Wrong:  EXPO_PUBLIC_API_URL=https://neurofit-backend.onrender.com
# Right:  EXPO_PUBLIC_API_URL=https://neurofit-backend.onrender.com/api

EXPO_PUBLIC_API_URL=https://YOUR_RENDER_APP_NAME.onrender.com/api
