# VYRN backend environment — copy to backend/.env and fill in real values.
# Never commit backend/.env or put the Supabase service-role key in the mobile app.

# AI coach
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq

# Supabase project (service key is backend-only)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT signing key. Generate a unique value with:
# python -c "import secrets; print(secrets.token_hex(32))"
# Replace the development default before any public deployment.
SECRET_KEY=dev-secret-key-change-in-production

# Comma-separated browser origins (native apps do not use browser CORS).
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Local vector-store data
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION_NAME=vyrn_guardrails
